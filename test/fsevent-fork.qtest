#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# Child processes created with fork() while a watcher exists.  Only the forking thread exists in a child: the
# watcher's watch thread remains in the parent, which also shares the watcher's kernel notification descriptor with
# the child.  The child must neither wait for the watch thread nor change the parent's watches.
#
# Each child exits with exit() and writes its result to a pipe whose write end it keeps open until it has exited:
# the parent reads until the end of the data, so it waits for the child's exit deterministically.  A child that
# waits forever makes the parent wait forever (the test runner's time limit is only a guard).

%modern
%no-child-restrictions

%requires QUnit
%requires FsUtil
%requires fsevent

%exec-class FsEventForkTest

#! a watcher that queues the names of the files of its events
class NameQueue inherits FsEvents::AbstractFsWatcher {
    private {
        Queue events;
    }

    constructor(Queue events) {
        self.events = events;
    }

    event(hash<FsEvents::FsEventInfo> event) {
        events.push(event.name);
    }
}

class FsEventForkTest inherits QUnit::Test {
    public {
        #! the longest a test waits for an event; it is a guard against a hang, never an expected time
        const EventTimeout = 60s;
    }

    constructor() : Test("fsevent fork test", "1.0", \ARGV) {
        addTestCase("a child destroys a watcher of its parent", \destroyTest());
        addTestCase("a child cannot use a watcher of its parent", \useTest());
        addTestCase("a child ends its script while a watcher of its parent exists", \scriptEndTest());
        set_return_value(main());
    }

    # the child destroys the watcher; it waited forever for the watch thread, which does not exist in the child.  The
    # parent's watch is unchanged.
    destroyTest() {
        checkFork();
        TmpDir tmp("fsevent-fork-");
        string dir = realpath(tmp.path);
        Queue events();
        NameQueue w(events);
        w.addPath(dir);
        trigger(dir, "before", events);
        assertEq("deleted", runChild(string sub () {
            delete w;
            return "deleted";
        }));
        trigger(dir, "after", events);
        assertEq(1, w.getWatchCount());
    }

    # every use of the watcher in the child that would change or read its watches raises FSWATCHER-FORK-ERROR; the
    # child changed the watches of the parent, with which it shares the kernel notification descriptor
    useTest() {
        checkFork();
        TmpDir tmp("fsevent-fork-");
        string dir = realpath(tmp.path);
        TmpDir other("fsevent-fork-other-");
        Queue events();
        NameQueue w(events);
        w.addPath(dir);
        trigger(dir, "before", events);
        string result = runChild(string sub () {
            list<string> results;
            foreach code c in ((sub () { w.addPath(realpath(other.path)); },
                sub () { w.addPathWithId(realpath(other.path)); },
                sub () { w.removePath(dir); },
                sub () { w.directories(); },
                sub () { w.getStatistics(); })) {
                try {
                    c();
                    results += "no error";
                } catch (hash<ExceptionInfo> ex) {
                    results += ex.err;
                }
            }
            results += sprintf("count=%d", w.getWatchCount());
            results += sprintf("watching=%y", w.isWatching(dir));
            return results.join(",");
        });
        assertEq("FSWATCHER-FORK-ERROR,FSWATCHER-FORK-ERROR,FSWATCHER-FORK-ERROR,FSWATCHER-FORK-ERROR,"
            "FSWATCHER-FORK-ERROR,count=0,watching=False", result);
        # the parent's watch is unchanged
        trigger(dir, "after", events);
        assertTrue(w.isWatching(dir));
        assertEq(1, w.getWatchCount());
    }

    # the child ends its script, which destroys the watcher, while the parent's watch thread runs; the script runs in
    # another process, whose output, and the child's, is read until both have exited
    scriptEndTest() {
        checkFork();
        TmpDir tmp("fsevent-fork-");
        TmpFile script(NOTHING, ".q");
        script.file.write("%modern\n%requires fsevent\n"
            "class W inherits FsEvents::AbstractFsWatcher {\n"
            "    event(hash<FsEvents::FsEventInfo> event) {}\n"
            "}\n"
            "W w();\n"
            "w.addPath(" + sprintf("%y", realpath(tmp.path)) + ");\n"
            "flush();\n"
            "if (!fork()) {\n"
            "    printf(\"child: done\\n\");\n"
            "} else {\n"
            "    printf(\"parent: done\\n\");\n"
            "}\n");
        script.file.close();
        string output = backquote(sprintf("%s --enable-debug %s 2>&1", shellQuote(QORE_ARGV[0]),
            shellQuote(script.path)));
        assertRegex("child: done", output);
        assertRegex("parent: done", output);
    }

    private checkFork() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
    }

    #! makes a file with the given name in the watched directory and waits for its event
    private static trigger(string dir, string name, Queue events) {
        File f();
        f.open2(dir + DirSep + name, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(name);
        f.close();
        # the creation of a file can be reported as more than one event
        while (events.get(EventTimeout) != name) {
        }
    }

    #! runs the code in a child process created with fork() and returns its result
    /** The child writes the string that the code returns, or the code of the exception that it raises, to a pipe and
        exits with exit() while it holds the write end of the pipe open, so the parent reads the result until the child
        has exited.
    */
    private string runChild(code child) {
        # an anonymous pipe needs no file, and the parent cannot block in the open of a named pipe that a child
        # ending early never opens
        hash<PipeInfo> pipe = File::getPipe();
        # the child must not write the parent's buffered output again when it exits
        flush();
        int pid = fork();
        if (!pid) {
            # the child holds the write end until it has exited: if it ends before it has written its result, the
            # parent reads to the end of what it wrote
            pipe.read.close();
            string result;
            try {
                result = child();
            } catch (hash<ExceptionInfo> ex) {
                result = "exception: " + ex.err;
            }
            pipe.write.write(result);
            Qore::exit(0);
        }
        pipe.write.close();
        assertGt(0, pid);
        string result;
        while (*binary data = pipe.read.readBinary(4096)) {
            result += data.toString();
        }
        return result;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }
}
