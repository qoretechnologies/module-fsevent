#include <qore/Qore.h>

static QoreNamespace FsEventsNS("Qore::FsEvents");

void init_constants_constants(QoreNamespace& ns);
QoreClass* initAbstractFsWatcherClass(QoreNamespace& ns);

DLLLOCAL TypedHashDecl* init_hashdecl_FsEventInfo(QoreNamespace& ns);

const TypedHashDecl* hashdeclFsEventInfo;

static void fsevent_module_init(QoreModuleInitContext& ctx, ExceptionSink& xsink);
static void fsevent_module_ns_init(QoreNamespace* rns, QoreNamespace* qns, ExceptionSink& xsink);
static void fsevent_module_delete();

extern "C" DLLEXPORT void fsevent_qore_module_desc(QoreModuleInfo& mod_info) {
    mod_info.name = "fsevent";
    mod_info.version = PACKAGE_VERSION;
    mod_info.desc = "Filesystem Events module";
    mod_info.author = "Petr Vanek";
    mod_info.url = "http://qore.org";
    mod_info.api_major = QORE_MODULE_API_MAJOR;
    mod_info.api_minor = QORE_MODULE_API_MINOR;
    mod_info.init = fsevent_module_init;
    mod_info.ns_init = fsevent_module_ns_init;
    mod_info.del = fsevent_module_delete;
#ifdef QORE_HAS_MODULE_NS_PURGE
    // the namespace is purged when the module is deleted, before the types are freed (see QoreModuleInfo::ns)
    mod_info.ns = &FsEventsNS;
#endif
    mod_info.license = QL_LGPL;
    mod_info.license_str = "LGPL";
}

static void fsevent_module_init(QoreModuleInitContext& ctx, ExceptionSink& xsink) {
    // initialize hashdecls first
    hashdeclFsEventInfo = init_hashdecl_FsEventInfo(FsEventsNS);

    // initialize constants
    init_constants_constants(FsEventsNS);

    // initialize classes
    FsEventsNS.addSystemClass(initAbstractFsWatcherClass(FsEventsNS));

}

static void fsevent_module_ns_init(QoreNamespace* rns, QoreNamespace* qns, ExceptionSink& xsink) {
    qns->addNamespace(FsEventsNS.copy());
}

static void fsevent_module_delete() {
   // nothing to do here in this case
}
