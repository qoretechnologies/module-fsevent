/* -*- mode: c++; indent-tabs-mode: nil -*- */
/*
*/

#include <qore/Qore.h>
#include <qore/QoreSandboxManager.h>
#include <efsw/efsw.hpp>
#include <efsw/base.hpp>

#include <thread>

#include <unistd.h>

using namespace efsw;

DLLLOCAL extern qore_classid_t CID_ABSTRACTFSWATCHER;
DLLLOCAL extern QoreClass* QC_ABSTRACTFSWATCHER;

DLLLOCAL extern const TypedHashDecl* hashdeclFsEventInfo;

// No global state needed - each callback reserves its own tid

class FsWatcherPriv : public AbstractPrivateData, public FileWatchListener {
protected:
    DLLLOCAL virtual ~FsWatcherPriv();

public:
    DLLLOCAL FsWatcherPriv(QoreObject *obj);

    DLLLOCAL int addWatch(const char * path, bool recursive, ExceptionSink *xsink);
    DLLLOCAL void removeWatch(WatchID id, ExceptionSink *xsink);
    DLLLOCAL void removeWatch(const char *path, ExceptionSink *xsink);
    DLLLOCAL QoreValue directories(ExceptionSink* xsink);

    DLLLOCAL void handleFileAction(WatchID watchid, const std::string& dir, const std::string& filename, Action action, std::string oldFilename = "");

    DLLLOCAL void stop() {
        //printd(5, "FsWatcherPriv::~FsWatcherPriv() this: %p\n", this);
        FileWatcher* fw = nullptr;
        if (forkedChild()) {
            // A child process created with fork(): the watch thread exists only in the parent, and the watcher's
            // kernel notification descriptor is shared with the parent.  Waiting for an in-flight callback or
            // joining the watch thread would wait forever, and removing the watches would remove the parent's, so
            // the watcher is abandoned without a lock (only the forking thread was copied; a lock that the watch
            // thread held stays held here); its memory is released with the process.
            m_fw = nullptr;
            stopped = true;
            return;
        }
        {
            AutoLocker al(callback_lock);

            // stop() is reached both from the destructor and from ~FsWatcherPriv(); it must be
            // idempotent
            if (stopped) {
                return;
            }
            // Signal that we are stopping so no new callbacks are dispatched
            stopping = true;
            stopped = true;

            // The Qore object's destructor runs on whichever thread removes the last reference to
            // the object graph. Because efsw delivers events from its own watch thread by calling
            // event() via execManaged(), that destructor can be triggered *on the watch thread
            // itself*, from inside an in-flight event() callback. In that case we cannot drain
            // callbacks (we are the callback) and we cannot join the watch thread (we are the watch
            // thread) - doing so would deadlock. Detect this re-entrant case and hand the watcher
            // off to a separate joiner thread that tears it down once this callback unwinds (the
            // efsw run loop exits when the watcher is deleted). This is the "external join".
            if (callback_tid != -1 && callback_tid == q_gettid()) {
                FileWatcher* rfw = m_fw;
                m_fw = nullptr;
                if (rfw) {
                    // keep this private data alive until the joiner has torn down the watcher
                    ref();
                    std::thread joiner([this, rfw]() {
                        // ~FileWatcher waits for the in-flight action to complete and then joins
                        // the watch thread; safe to call from this external thread
                        delete rfw;
                        ExceptionSink xsink;
                        deref(&xsink);
                    });
                    joiner.detach();
                }
                return;
            }

            // Normal case: destructor runs on a thread other than the watch thread. Wait for any
            // in-flight callback to complete before deleting the watcher, so no callback is running
            // when we destroy internal state.
            while (callback_count > 0) {
                callback_cond.wait(callback_lock);
            }
            fw = m_fw;
            m_fw = nullptr;
        }
        // Delete the watcher with callback_lock released: ~FileWatcher joins the watch thread, and
        // the watch thread may still be entering handleFileAction() where it must acquire
        // callback_lock to observe stopping==true and bail out. Holding the lock here would
        // deadlock against that. (stopping is already set, so no new callback will run.)
        delete fw;
    }

    // Symlink support - these methods must not be called after stop(); in a child process created with fork(), the
    // watcher behaves as if it were stopped (see getWatcher())
    DLLLOCAL void setFollowSymlinks(bool follow) {
        if (FileWatcher* fw = getWatcher()) {
            fw->followSymlinks(follow);
        }
    }

    DLLLOCAL bool getFollowSymlinks() const {
        FileWatcher* fw = getWatcher();
        return fw ? fw->followSymlinks() : false;
    }

    DLLLOCAL void setAllowOutOfScopeLinks(bool allow) {
        if (FileWatcher* fw = getWatcher()) {
            fw->allowOutOfScopeLinks(allow);
        }
    }

    DLLLOCAL bool getAllowOutOfScopeLinks() const {
        FileWatcher* fw = getWatcher();
        return fw ? fw->allowOutOfScopeLinks() : false;
    }

    // Query methods - return safe defaults if watcher is stopped
    DLLLOCAL int getWatchCount() const {
        FileWatcher* fw = getWatcher();
        return fw ? fw->directories().size() : 0;
    }

    DLLLOCAL bool isWatching(const char* path) const {
        FileWatcher* fw = getWatcher();
        if (!fw) {
            return false;
        }
        const std::vector<std::string>& dirs = fw->directories();
        std::string pathStr(path);
        for (const auto& dir : dirs) {
            if (dir == pathStr || dir == pathStr + "/") {
                return true;
            }
        }
        return false;
    }

    DLLLOCAL const char* getBackendType() const {
#if defined(__linux__)
        return "inotify";
#elif EFSW_PLATFORM == EFSW_PLATFORM_FSEVENTS
        return "fsevents";
#elif defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__)
        return "kqueue";
#elif defined(_WIN32)
        return "win32";
#else
        return "generic";
#endif
    }

private:
    FileWatcher* m_fw;
    const QoreMethod* event;
    QoreObject* m_obj;
    // the process that created the watcher and its watch thread
    pid_t pid;

    // returns true in a child process created with fork() after the watcher was created: the watch thread exists
    // only in the parent, which shares the watcher's kernel notification descriptor
    DLLLOCAL bool forkedChild() const {
        return getpid() != pid;
    }

    // returns the watcher, or nullptr if it has been stopped or if this is a child process created with fork()
    // after the watcher was created
    DLLLOCAL FileWatcher* getWatcher() const {
        return forkedChild() ? nullptr : m_fw;
    }

    // raises FSWATCHER-FORK-ERROR in a child process created with fork() after the watcher was created
    DLLLOCAL int checkProcess(ExceptionSink* xsink) const {
        if (forkedChild()) {
            xsink->raiseException("FSWATCHER-FORK-ERROR", "the watcher was created by process %d; it cannot be used "
                "in a child process created with fork(), as its watch thread exists only in that process",
                static_cast<int>(pid));
            return -1;
        }
        return 0;
    }

    // Thread safety for callbacks during destruction
    mutable QoreThreadLock callback_lock;
    QoreCondition callback_cond;
    unsigned callback_count = 0;
    bool stopping = false;
    // set once the watcher has been torn down; makes stop() idempotent
    bool stopped = false;
    // Qore thread ID of the thread currently executing an event() callback, or -1 if none. Used to
    // detect a destructor invoked re-entrantly from within an in-flight callback (see stop()).
    // Protected by callback_lock.
    int callback_tid = -1;
    // The sandbox of the code that created the watcher, captured in the constructor. efsw calls event() on its
    // own watch thread, which Qore did not start and which has no caller; each callback runs under this sandbox,
    // so the callback can never do more than the code that created the watcher.
    QoreSandboxCapture sandbox;
};

FsWatcherPriv::FsWatcherPriv(QoreObject *obj) : pid(getpid()) {
    //printd(5, "FsWatcherPriv::FsWatcherPriv() this: %p\n", this);
    m_fw = new FileWatcher();
    event = obj->getClass()->findMethod("event");
    assert(event);
    m_obj = obj;
    m_fw->watch();
}

FsWatcherPriv::~FsWatcherPriv() {
    // Handle case where destructor is called without stop() - can happen
    // if constructor throws an exception after watcher creation
    if (m_fw) {
        stop();
    }
}

int FsWatcherPriv::addWatch(const char * path, bool recursive, ExceptionSink *xsink) {
    if (checkProcess(xsink)) {
        return 0;
    }
    // Check filesystem sandbox access before monitoring directory
    QoreSandboxManagerHelper smh;
    if (smh && !smh->checkFilesystemAccess(path, QSEC_READ, xsink)) {
        // checkFilesystemAccess should have raised an exception
        assert(*xsink);
        return 0;
    }

    WatchID id = m_fw->addWatch(path, this, recursive);

    switch (id) {
        case Errors::FileNotFound:
        case Errors::FileRepeated:
        case Errors::FileOutOfScope:
        case Errors::Unspecified:
            xsink->raiseException("FSWATCHER-ADD-ERROR", Errors::Log::getLastErrorLog().c_str());
            return 0;

        default:
            return id;
    }
}

void FsWatcherPriv::removeWatch(WatchID id, ExceptionSink *xsink) {
    if (checkProcess(xsink)) {
        return;
    }
    m_fw->removeWatch(id);
}

void FsWatcherPriv::removeWatch(const char * path, ExceptionSink *xsink) {
    if (checkProcess(xsink)) {
        return;
    }
    m_fw->removeWatch(path);
}

QoreValue FsWatcherPriv::directories(ExceptionSink* xsink) {
    if (checkProcess(xsink)) {
        return QoreValue();
    }
    const std::vector<std::string>& dirs = m_fw->directories();
    if (!dirs.size()) {
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> ret(new QoreListNode(stringTypeInfo), xsink);
    for (auto& it : dirs) {
        ret->push(new QoreStringNode(it), xsink);
    }

    return ret.release();
}

/// Handles the action file action
/// @param watchid The watch id for the directory
/// @param dir The directory
/// @param filename The filename that was accessed (not full path)
/// @param action Action that was performed
/// @param oldFilename The name of the file or directory moved
void FsWatcherPriv::handleFileAction(WatchID watchid, const std::string& dir, const std::string& filename, Action action, std::string oldFilename) {
    // CRITICAL: Copy parameters immediately before any locking or checking
    // efsw may free the underlying memory during watcher destruction, so we must
    // own copies of all data before we do anything else
    std::string localDir(dir);
    std::string localFilename(filename);
    std::string localOldFilename(oldFilename);
    WatchID localWatchid = watchid;
    Action localAction = action;

    // Check if we're stopping and register this callback. We only hold callback_lock briefly here
    // (not across the callback itself): the watch thread is single-threaded so callbacks are
    // already serialized, and holding the lock across execManaged() would deadlock if the callback
    // triggers this object's destructor on the watch thread (see stop()).
    {
        AutoLocker al(callback_lock);
        if (stopping) {
            return;
        }
        ++callback_count;
    }

    // Ensure we decrement callback count and signal when done, on every exit path
    struct CallbackGuard {
        FsWatcherPriv* priv;
        CallbackGuard(FsWatcherPriv* p) : priv(p) {}
        ~CallbackGuard() {
            AutoLocker al(priv->callback_lock);
            priv->callback_tid = -1;
            if (--priv->callback_count == 0) {
                priv->callback_cond.signal();
            }
        }
    } guard(this);

    // Use the simple foreign thread helper - it auto-registers and deregisters the thread
    QoreForeignThreadHelper qfth;
    // Check if thread registration succeeded - it can fail during program shutdown
    if (!qfth) {
        return;
    }

    ExceptionSink xsink;

    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &xsink);
    ReferenceHolder<QoreHashNode> event_info(new QoreHashNode(hashdeclFsEventInfo, &xsink), &xsink);
    event_info->setKeyValue("id", localWatchid, &xsink);
    event_info->setKeyValue("dir", new QoreStringNode(localDir), &xsink);
    event_info->setKeyValue("name", new QoreStringNode(localFilename), &xsink);
    event_info->setKeyValue("action", localAction, &xsink);
    if (!localOldFilename.empty()) {
        event_info->setKeyValue("old_name", new QoreStringNode(localOldFilename), &xsink);
    }
    args->push(event_info.release(), &xsink);

    // Record that a callback is running on this thread so that a destructor triggered from within
    // the callback (on this same watch thread) can be detected and handled by stop()
    {
        AutoLocker al(callback_lock);
        callback_tid = q_gettid();
    }

    // Pin the object for the duration of the callback. Without this, another thread dropping the
    // last reference to the object during event() would trigger the object's destructor on this
    // watch thread *while event() is still running*, destroying object state out from under the
    // callback (use-after-free). Holding our own reference guarantees the destructor cannot fire
    // until after execManaged() returns; if our deref() below is then the last one, the destructor
    // runs here but only after event() has fully completed, and stop() handles the watch-thread
    // case via the external join.
    m_obj->ref();
    {
        // the callback, and an object destructor that its release runs, are governed by the sandbox of the code
        // that created the watcher
        QoreSandboxCaptureHelper sch(sandbox);
        //printd(5, "FsWatcherPriv::handleFileAction this: %p m_obj: %p refs: %d\n", this, m_obj, m_obj->reference_count());
        event->execManaged(m_obj, *args, &xsink).discard(&xsink);
        //m_obj->evalMethodValue("event", *args, &xsink).discard(&xsink);
        m_obj->deref(&xsink);
    }
}

//! Filesystem Event information
/**
*/
hashdecl Qore::FsEvents::FsEventInfo {
    //! monitoring id as returned from AbstractFsWatcher::addPath()
    int id;

    //! the directory path
    string dir;

    //! the affected file name (without the path)
    string name;

    //! the action type; one of @ref fsevent_constants
    int action;

    //! oldFname the old file name if the action is Qore::FsEvents::MOVED
    *string old_name;
}

//! Implementation of filesystem event watcher.
/**
    This is an abstract class. Developers have to inherit AbstractFsWatcher with method event() implemented.

    @par Thread Safety
    - The AbstractFsWatcher class is thread-safe for concurrent calls to addPath(), removePath(), and directories()
    - The event() callback is called from a background thread managed by the filesystem watcher
    - Event callbacks are serialized: only one event() callback executes at a time for a given watcher instance
    - User code in event() should still be thread-safe if sharing state with other user-created threads

    @par Callback Serialization
    - The implementation ensures that event() is not re-entrant: no new event() call starts while a previous one is executing
    - This simplifies event handler implementation as you don't need internal synchronization for watcher-local state
    - If you require concurrent processing of events, offload work from event() to your own worker threads
    - Note: multiple foreign thread IDs may be allocated by efsw even though callbacks are serialized

    @par Sandboxing
    - The event() callback runs under the sandbox (\c Qore::SandboxManager) of the code that created the watcher: the
      filesystem and network policy that governed the constructor call also governs every event() call, although
      the callbacks run on the watcher's own thread
    - addPath() checks read access to the path with the sandbox of the code that calls it

    @par Child Processes Created with fork()
    - A watcher cannot be used in a child process created with \c fork() after the watcher was created: its watch
      thread exists only in the parent, and the child shares the watcher's kernel notification descriptor with the
      parent.  In the child, the watcher delivers no events and reports no watched directories, addPath(),
      addPathWithId(), removePath(), directories() and getStatistics() raise \c FSWATCHER-FORK-ERROR, and the
      destruction of the watcher neither waits for the watch thread nor changes the parent's watches

    @par Exception Handling
    - Exceptions thrown in the event() callback are caught and discarded to prevent crashing the watcher thread
    - Use try/catch in event() to handle and log exceptions appropriately
    - addPath() throws FSWATCHER-ADD-ERROR if the path cannot be watched
    - copy() throws FSWATCHER-COPY-ERROR as copying is not supported

    @par Error Codes
    Errors from addPath() may include:
    - FileNotFound: The directory does not exist
    - FileRepeated: The directory is already being watched
    - FileOutOfScope: The path is outside the allowed scope (symlink issue)
    - FileNotReadable: Permission denied
    - Unspecified: Other platform-specific error

    <b>Basic Example</b>

    @code{.py}
%requires fsevent

class MyWatcher inherits FsEvents::AbstractFsWatcher {
    event(hash<FsEventInfo> event) {
        printf("FS event: %d, %s, %s, %d, %s\n", event.id, event.dir,
            event.name, event.action, event.old_name);
    }
}

MyWatcher w();
w.addPath('/var/log/');
while (True) {
    sleep(1);
}
    @endcode

    <b>Thread-Safe Example</b>

    @code{.py}
%requires fsevent

class ThreadSafeWatcher inherits FsEvents::AbstractFsWatcher {
    private {
        Mutex m();
        list<hash<FsEventInfo>> events();
    }

    event(hash<FsEventInfo> event) {
        AutoLock al(m);
        events += event;
    }

    list<hash<FsEventInfo>> getEvents() {
        AutoLock al(m);
        list<hash<FsEventInfo>> ret = events;
        events = ();
        return ret;
    }
}
    @endcode
*/
qclass AbstractFsWatcher [dom=FILESYSTEM; arg=FsWatcherPriv* priv; ns=Qore::FsEvents];

//! Create an empty file system watcher. No directories are monitored.
/**
 */
AbstractFsWatcher::constructor() {
    self->setPrivate(CID_ABSTRACTFSWATCHER, new FsWatcherPriv(self));
}

//! Copy method - instance of this class cannot be copied.
/**
    @throw FSWATCHER-COPY-ERROR	- Copying of AbstractFsWatcher objects is not supported
 */
AbstractFsWatcher::copy() {
    xsink->raiseException("FSWATCHER-COPY-ERROR", "copying AbstractFsWatcher objects is currently not supported");
}

//! stops the watcher thread and destroyes the object
/**
 */
AbstractFsWatcher::destructor() {
    //printd(5, "AbstractFsWatcher::destructor() priv: %p\n", priv);
    priv->stop();
    priv->deref(xsink);
}

//! Add new path for monitoring.
/**
    @param path	a string with path to be monitored
    @param recursive False = only the top level directory is monitored; True = all sub-directories are monitored too

    @returns the object itself for method chaining (fluent API)

    @note To get the watch ID when adding a path, use addPathWithId() instead of this method.

    @throw FSWATCHER-ADD-ERROR if the path cannot be watched
    @throw FSWATCHER-FORK-ERROR the watcher was created by another process (this is a child process created with
    \c fork())

    Example:
    @code{.py}
    MyWatcher w();
    w.addPath("/var/log").addPath("/tmp").setFollowSymlinks(True);
    @endcode

    @since 2.0 - Changed return type from int to AbstractFsWatcher for fluent API
 */
AbstractFsWatcher AbstractFsWatcher::addPath(string path, bool recursive = False) [flags=NAMED_ARGS] {
    priv->addWatch(path->getBuffer(), recursive, xsink);
    return self->refSelf();
}

//! Remove a directory tree from monitoring by its id.
/**
    @param id an integer value. Obtained by AbstractFsWatcher::addPath

    This method uses a map lookup: \a O(ln(n))

    @throw FSWATCHER-FORK-ERROR the watcher was created by another process (this is a child process created with
    \c fork())
 */
AbstractFsWatcher::removePath(int id) [flags=NAMED_ARGS] {
    priv->removeWatch(id, xsink);
}

//! Remove a directory tree from monitoring by its name.
/**
    @param path	a named path to remove

    This method uses a linear search: \a O(n)

    @throw FSWATCHER-FORK-ERROR the watcher was created by another process (this is a child process created with
    \c fork())
 */
AbstractFsWatcher::removePath(string path) [flags=NAMED_ARGS] {
    priv->removeWatch(path->getBuffer(), xsink);
}

//! Return all monitored directories.
/**
    @return list of all registered (top-level) directories in this watcher instance or @ref nothing if there is no
    directory registered

    @throw FSWATCHER-FORK-ERROR the watcher was created by another process (this is a child process created with
    \c fork())
 */
*list<string> AbstractFsWatcher::directories() {
    return priv->directories(xsink);
}

//! Filesystem event handler/callback.
/** @param event the filesystem event hash
 */
abstract AbstractFsWatcher::event(hash<FsEventInfo> event);

//! Enable or disable following symbolic links.
/**
    @param follow True to follow symlinks, False to ignore them

    @note This setting must be applied before calling addPath() to take effect for that path.
    Windows implementations ignore this setting.

    @see getFollowSymlinks()
 */
AbstractFsWatcher::setFollowSymlinks(bool follow) [flags=NAMED_ARGS] {
    priv->setFollowSymlinks(follow);
}

//! Returns whether symbolic links are being followed.
/**
    @return True if symlinks are followed, False otherwise

    @see setFollowSymlinks()
 */
bool AbstractFsWatcher::getFollowSymlinks() {
    return priv->getFollowSymlinks();
}

//! Enable or disable following symbolic links that point outside the watched directory.
/**
    @param allow True to allow out-of-scope symlinks, False to ignore them

    @note This setting requires followSymlinks to be enabled. Must be applied before addPath().
    Windows implementations ignore this setting.

    @see getAllowOutOfScopeLinks()
    @see setFollowSymlinks()
 */
AbstractFsWatcher::setAllowOutOfScopeLinks(bool allow) [flags=NAMED_ARGS] {
    priv->setAllowOutOfScopeLinks(allow);
}

//! Returns whether out-of-scope symbolic links are being followed.
/**
    @return True if out-of-scope symlinks are allowed, False otherwise

    @see setAllowOutOfScopeLinks()
 */
bool AbstractFsWatcher::getAllowOutOfScopeLinks() {
    return priv->getAllowOutOfScopeLinks();
}

//! Returns the last error code from the filesystem watcher library.
/**
    @return The last error code (one of @ref fsevent_error_constants), or E_NOERROR if no error

    This is a process-global value. Call immediately after a failed addPath() to get the error code.

    @see getLastErrorMessage()
    @see clearLastError()
 */
static int AbstractFsWatcher::getLastErrorCode() {
    return Errors::Log::getLastErrorCode();
}

//! Returns the last error message from the filesystem watcher library.
/**
    @return A string describing the last error, or an empty string if no error

    This is a process-global value. Call immediately after a failed addPath() to get the error message.

    @see getLastErrorCode()
    @see clearLastError()
 */
static string AbstractFsWatcher::getLastErrorMessage() {
    return new QoreStringNode(Errors::Log::getLastErrorLog());
}

//! Clears the last error state.
/**
    Resets the process-global error state to no error.

    @see getLastErrorCode()
    @see getLastErrorMessage()
 */
static AbstractFsWatcher::clearLastError() {
    Errors::Log::clearLastError();
}

//! Returns the name of the backend being used for filesystem monitoring.
/**
    @return A string identifying the backend: "inotify" (Linux), "kqueue" (macOS/BSD),
            "win32" (Windows), or "generic" (polling fallback)

    The backend is determined at compile time based on the platform.
 */
string AbstractFsWatcher::getBackendType() {
    return new QoreStringNode(priv->getBackendType());
}

//! Returns the number of directories currently being watched.
/**
    @return The count of watched directories
 */
int AbstractFsWatcher::getWatchCount() {
    return priv->getWatchCount();
}

//! Returns whether a specific path is being watched.
/**
    @param path The directory path to check

    @return True if the path is being watched, False otherwise
 */
bool AbstractFsWatcher::isWatching(string path) [flags=NAMED_ARGS] {
    return priv->isWatching(path->getBuffer());
}

//! Adds a path and returns the watch ID.
/**
    @param path a string with path to be monitored
    @param recursive False = only the top level directory is monitored; True = all sub-directories are monitored too

    @returns an integer id of the monitored tree, or 0 on error

    This method is provided for backward compatibility and when the watch ID is needed.
    For fluent API, use addPath() instead.

    @throw FSWATCHER-ADD-ERROR if the path cannot be watched
    @throw FSWATCHER-FORK-ERROR the watcher was created by another process (this is a child process created with
    \c fork())

    @see addPath()
 */
int AbstractFsWatcher::addPathWithId(string path, bool recursive = False) [flags=NAMED_ARGS] {
    return priv->addWatch(path->getBuffer(), recursive, xsink);
}

//! Returns statistics about the watcher.
/**
    @return A hash with the following keys:
    - \c watchCount (int): Number of directories being watched
    - \c backend (string): The backend type ("inotify", "kqueue", "win32", or "generic")
    - \c directories (list<string>): List of watched directories (or NOTHING if empty)
    - \c followSymlinks (bool): Whether symlinks are being followed
    - \c allowOutOfScopeLinks (bool): Whether out-of-scope symlinks are allowed

    @throw FSWATCHER-FORK-ERROR the watcher was created by another process (this is a child process created with
    \c fork())
 */
hash<auto> AbstractFsWatcher::getStatistics() {
    ReferenceHolder<QoreHashNode> rv(new QoreHashNode(autoTypeInfo), xsink);
    rv->setKeyValue("watchCount", priv->getWatchCount(), xsink);
    rv->setKeyValue("backend", new QoreStringNode(priv->getBackendType()), xsink);
    rv->setKeyValue("directories", priv->directories(xsink), xsink);
    rv->setKeyValue("followSymlinks", priv->getFollowSymlinks(), xsink);
    rv->setKeyValue("allowOutOfScopeLinks", priv->getAllowOutOfScopeLinks(), xsink);
    return rv.release();
}
